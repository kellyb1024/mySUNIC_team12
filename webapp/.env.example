# ══════════════════════════════════════════════════════════════════════
# Supabase 접속 정보 — 이 파일은 예시입니다. 실제 값은 .env.local 에 넣으세요
#
# Supabase 대시보드 → Project Settings → API 에서 복사해 넣으세요.
#   NEXT_PUBLIC_SUPABASE_URL       Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  anon (public) 키
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저까지 전달됩니다. anon 키는
# 원래 그렇게 쓰는 키라 괜찮습니다.
#
# ⚠️ service_role 키는 절대 NEXT_PUBLIC_ 로 넣지 마세요.
#    서버에서만 쓸 일이 생기면 접두사 없이 SUPABASE_SERVICE_ROLE_KEY 로 둡니다.
# ══════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi…
